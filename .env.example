# ── MiMo LLM (default backend) ───────────────────────────────────────────────
# Required when LLM_BACKEND=mimo (the default).
OPENAI_BASE_URL=https://api.mimo.ai/v1
OPENAI_API_KEY=your-mimo-key-here

# Model name overrides (defaults shown)
# MIMO_MODEL_FAST=mimo-v2.5
# MIMO_MODEL_THINK=mimo-v2.5-pro

# ── Ollama (alternative backend) ─────────────────────────────────────────────
# Uncomment these two lines to switch to a local Ollama model.
# LLM_BACKEND=ollama
# OLLAMA_MODEL=qwen3.5:9b
# Keep local context modest on an 8 GB GPU; benchmark review tools use 8192.
# OLLAMA_NUM_CTX=8192

# ── Vector database ───────────────────────────────────────────────────────────
# Default: http://localhost:6333  (docker run -p 6333:6333 qdrant/qdrant)
# QDRANT_URL=http://localhost:6333

# ── Hardware ──────────────────────────────────────────────────────────────────
# auto = use CUDA if available, else CPU.  Force with cuda or cpu.
# RERANKER_DEVICE=auto

# ── MCP server auth (optional) ────────────────────────────────────────────────
# When set, every MCP tool call must supply this token.
# Leave unset for local dev (auth disabled).
# MEDRAG_LOCAL_TOKEN=replace-with-a-long-random-string

# ── Evaluation judge (optional) ───────────────────────────────────────────────
# Scripts 11/12 use these to call an independent judge LLM.
# If unset, they fall back to OPENAI_API_KEY (self-evaluation; biased scores).
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=your-judge-key
# JUDGE_MODEL=gpt-4o

# Isolated small showcase corpus (research corpus: medrag_text)
QDRANT_COLLECTION=medrag_demo
# OLLAMA_HOST=http://127.0.0.1:11434
# LLM_TIMEOUT_SECONDS=60
# NCBI_EMAIL=you@example.com
