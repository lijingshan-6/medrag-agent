# ── Selected v0.4 baseline: Flash via a compatible gateway ─────────────────
# Replace the placeholder key in your ignored local .env.
LLM_BACKEND=openhub
OPENHUB_BASE_URL=https://www.cun.ai/v1
OPENHUB_API_KEY=your-gateway-key
OPENHUB_MODEL=DeepSeek-V4.1-Flash
OPENHUB_REASONING_EFFORT=high
OPENHUB_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=240

# ── MiMo (alternative; code fallback when no backend is set) ────────────────
# LLM_BACKEND=mimo
# OPENAI_BASE_URL=https://api.mimo.ai/v1
# OPENAI_API_KEY=your-mimo-key-here

# Model name overrides (defaults shown)
# MIMO_MODEL_FAST=mimo-v2.5
# MIMO_MODEL_THINK=mimo-v2.5-pro

# ── Ollama (alternative backend) ─────────────────────────────────────────────
# Replace LLM_BACKEND above with ollama, then set these local values.
# LLM_BACKEND=ollama
# OLLAMA_MODEL=qwen3.5:9b

# Flash baseline decision: docs/decisions/2026-09-23-flash-research-baseline.md
# The existing openhub backend supports a configurable compatible base URL.
# Streaming transport and thinking are enabled for both Agent tiers.
# Both tiers use Flash; Pro is only an explicitly selected comparison model.
# The 8192-token local context setting applies only to Ollama.

# ── Vector database ───────────────────────────────────────────────────────────
# Default: http://localhost:6333  (docker run -p 6333:6333 qdrant/qdrant)
# QDRANT_URL=http://localhost:6333

# ── Hardware ──────────────────────────────────────────────────────────────────
# auto = use CUDA if available, else CPU.  Force with cuda or cpu.
# RERANKER_DEVICE=auto

# ── MCP server auth (optional) ────────────────────────────────────────────────
# When set, every MCP tool call must supply this token.
# Leave unset for local dev (auth disabled).
# MEDRAG_LOCAL_TOKEN=replace-with-a-long-random-string

# ── Evaluation judge (optional) ───────────────────────────────────────────────
# Scripts 11/12 use these to call an independent judge LLM.
# If unset, they fall back to OPENAI_API_KEY (self-evaluation; biased scores).
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=your-judge-key
# JUDGE_MODEL=gpt-4o

# Isolated small showcase corpus (research corpus: medrag_text)
QDRANT_COLLECTION=medrag_demo
# OLLAMA_HOST=http://127.0.0.1:11434
# LLM_TIMEOUT_SECONDS=240
# NCBI_EMAIL=you@example.com
