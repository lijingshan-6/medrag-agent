+        own = [c for c in claims if c.get("component_id") == component["id"]]
+        if component["status"] == "missing":
+            continue
+        critical = any(re.search(r"\d", d) or _METHOD_STEPS.search(normalized(d))
+                       for d in component["required_details"])
