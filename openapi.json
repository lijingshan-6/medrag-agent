{
  "openapi": "3.1.0",
  "info": {
    "title": "VeritasMed API",
    "description": "Self-verifying medical literature QA backend",
    "version": "0.4.0"
  },
  "paths": {
    "/api/search": {
      "get": {
        "summary": "Search",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "title": "Q"
            }
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 5,
              "title": "K"
            }
          },
          {
            "name": "pipeline",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^p[23]$",
              "default": "p2",
              "title": "Pipeline"
            }
          },
          {
            "name": "highlight",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Highlight"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/document/{citation}": {
      "get": {
        "summary": "Get Document",
        "operationId": "get_document_api_document__citation__get",
        "parameters": [
          {
            "name": "citation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Citation"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chunk/{chunk_id}": {
      "get": {
        "summary": "Get Chunk",
        "description": "Return the chunk and its neighbouring chunks.",
        "operationId": "get_chunk_api_chunk__chunk_id__get",
        "parameters": [
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chunk Id"
            }
          },
          {
            "name": "context_window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "minimum": 0,
              "default": 1,
              "title": "Context Window"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChunkContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/history/{thread_id}": {
      "get": {
        "summary": "Get History",
        "operationId": "get_history_api_history__thread_id__get",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/corpus/stats": {
      "get": {
        "summary": "Corpus Stats",
        "operationId": "corpus_stats_api_corpus_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusStats"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_api_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Api Live Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChunkContextResponse": {
        "properties": {
          "chunk": {
            "$ref": "#/components/schemas/ChunkSlim"
          },
          "prev_chunk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkSlim"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_chunk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkSlim"
              },
              {
                "type": "null"
              }
            ]
          },
          "document": {
            "additionalProperties": true,
            "type": "object",
            "title": "Document"
          }
        },
        "type": "object",
        "required": [
          "chunk",
          "document"
        ],
        "title": "ChunkContextResponse"
      },
      "ChunkOut": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "e.g. 'pubmed:12345:0' or 'pmc:doc196:3'"
          },
          "citation": {
            "type": "string",
            "title": "Citation",
            "description": "e.g. 'PMID:12345' or 'PMC:doc196'"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "'pubmed' or 'pmc'"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pmid"
          },
          "chunk_idx": {
            "type": "integer",
            "title": "Chunk Idx"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "highlight_ranges": {
            "items": {
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Highlight Ranges"
          },
          "external_url": {
            "type": "string",
            "title": "External Url",
            "default": ""
          },
          "authors": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authors"
          },
          "journal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journal"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "citation",
          "source",
          "doc_id",
          "title",
          "chunk_idx",
          "total_chunks",
          "text"
        ],
        "title": "ChunkOut"
      },
      "ChunkSlim": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "title": "ChunkSlim"
      },
      "CorpusStats": {
        "properties": {
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "pubmed_chunks": {
            "type": "integer",
            "title": "Pubmed Chunks"
          },
          "pmc_chunks": {
            "type": "integer",
            "title": "Pmc Chunks"
          },
          "collection": {
            "type": "string",
            "title": "Collection"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          }
        },
        "type": "object",
        "required": [
          "total_chunks",
          "pubmed_chunks",
          "pmc_chunks",
          "collection",
          "embedding_model"
        ],
        "title": "CorpusStats"
      },
      "DocumentChunkSlim": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "chunk_idx": {
            "type": "integer",
            "title": "Chunk Idx"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "chunk_idx",
          "text"
        ],
        "title": "DocumentChunkSlim"
      },
      "DocumentResponse": {
        "properties": {
          "citation": {
            "type": "string",
            "title": "Citation"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pmid"
          },
          "external_url": {
            "type": "string",
            "title": "External Url"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunkSlim"
            },
            "type": "array",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "citation",
          "source",
          "doc_id",
          "title",
          "pmid",
          "external_url",
          "total_chunks",
          "chunks"
        ],
        "title": "DocumentResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "qdrant": {
            "type": "string",
            "title": "Qdrant"
          },
          "llm": {
            "type": "string",
            "title": "Llm"
          }
        },
        "type": "object",
        "required": [
          "status",
          "qdrant",
          "llm"
        ],
        "title": "HealthResponse"
      },
      "HistoryResponse": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/HistoryTurn"
            },
            "type": "array",
            "title": "Turns"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "turns",
          "summary"
        ],
        "title": "HistoryResponse"
      },
      "HistoryTurn": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "query",
          "answer",
          "citations",
          "timestamp"
        ],
        "title": "HistoryTurn"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "pipeline": {
            "type": "string",
            "title": "Pipeline"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/ChunkOut"
            },
            "type": "array",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "query",
          "pipeline",
          "latency_ms",
          "chunks"
        ],
        "title": "SearchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
